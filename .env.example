# Required for AI guidance. Without it /api/recommend answers 503 and the app shows the rule-based plan.
ANTHROPIC_API_KEY=
# Optional
ANTHROPIC_MODEL=claude-opus-5-5
# Exact origin allowed to call the API (e.g. https://your-app.vercel.app). Defaults to same-host only.
ALLOWED_ORIGIN=
RATE_LIMIT_PER_MIN=6
# Optional shared rate limit across serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
